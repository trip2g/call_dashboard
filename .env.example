# Telegram: a bot from @BotFather, and your own numeric Telegram user id
# (ask @userinfobot). Only this user may talk to the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Codex models, served through your ChatGPT subscription.
HERMES_MODEL=gpt-6-sol
ROLE_MODEL=gpt-6-sol

# Where you open the dashboard; links in Telegram point here.
PUBLIC_URL=http://localhost:8380
TRIP2G_PORT=8380

# Filled in by scripts/setup.sh. Leave empty.
MINIO_PASSWORD=
OWNER_TOKEN=
JWT_SECRET=
DATA_ENCRYPTION_KEY=
FLEET_SECRET=
BRIDGE_KEY=
VAULT_API_KEY=
