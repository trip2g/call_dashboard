COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
TRIP2G_IMAGE={{ trip2g_image }}
PUBLIC_URL=https://{{ calls_domain }}
OWNER_EMAIL={{ calls_owner_email }}

TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_OWNER_ID={{ telegram_owner_id }}
HERMES_MODEL={{ hermes_model }}
ROLE_MODEL={{ role_model }}

MINIO_PASSWORD=unused-storage-is-local
{% for name in calls_secret_names + calls_api_key_names %}
{% if calls_secrets[name] is defined %}
{{ name }}={{ calls_secrets[name] }}
{% endif %}
{% endfor %}
{% if smtp_host is defined %}
SMTP_USER={{ smtp_user }}
SMTP_PASS={{ smtp_pass }}
{% endif %}
